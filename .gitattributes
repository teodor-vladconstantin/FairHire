# contracts/managed/ is compact compile's output, committed so Vercel (and
# any fresh clone) can build without the Compact CLI installed. .prover/
# .verifier/.bzkir are genuinely binary (PLONK keys, packed ZKIR) — mark
# them explicitly so core.autocrlf never rewrites their bytes.
*.prover binary
*.verifier binary
*.bzkir binary

# .zk-params/ holds the Compact compiler's public BLS trusted-setup
# parameters (bls_midnight_2p<k> — a shared, publicly-known constant per
# circuit size, not a secret or machine-specific value), committed for the
# same reason as contracts/managed/ above: Vercel's runtime needs them and
# has no Compact CLI to (re)fetch them. Also genuinely binary.
.zk-params/* binary
