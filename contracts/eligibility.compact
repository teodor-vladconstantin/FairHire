pragma language_version >= 0.23.0;

import CompactStandardLibrary;

export ledger qualifiesCount: Counter;

export ledger usedNullifiers: Map<Bytes<32>, Boolean>;

// Expiry timestamp (Unix epoch seconds) recorded alongside each nullifier at
// the moment it was accepted — see step 0 below. Additive to usedNullifiers,
// not a replacement: existing readers of usedNullifiers are unaffected.
export ledger nullifierExpiry: Map<Bytes<32>, Uint<64>>;

export circuit verifyAndApply(
                 matchScore: Uint<8>,
                 meetsMinCriteria: Boolean,
                 candidateSecret: Bytes<32>,
                 issuerPublicKey: Bytes<32>,
                 issuerSignature: Bytes<32>,
                 jobId: Bytes<32>,
                 minScoreThreshold: Uint<8>,
                 expiryTimestamp: Uint<64>
                 ): [] {
  // 0. Reject proofs for job postings that have already expired. Compared
  //    against the ledger's own block time (blockTimeLt), not the client's
  //    clock, so a candidate can't backdate an expired posting by lying
  //    about the current time.
  assert(blockTimeLt(disclose(expiryTimestamp)), "Job posting has expired!");

  // 1. Verify Issuer Attestation
  const expectedCommitment =
          persistentHash<[Bytes<32>, Uint<8>, Boolean]>(
            [issuerPublicKey, matchScore, meetsMinCriteria]
            );
  assert(issuerSignature == expectedCommitment, "Invalid Score Attestation!");

  // 2. Prevent Replay via Nullifier
  //    Disclosure #1: the nullifier itself becomes public. It is a one-way
  //    hash of (candidateSecret, jobId), so it leaks neither the secret nor
  //    any qualification data — it only makes replays detectable.
  const nullifier = disclose(persistentHash<Vector<2, Bytes<32>>>([candidateSecret, jobId]));
  assert(!usedNullifiers.member(nullifier), "Proof already used for this job!");

  // 3. Evaluate Composite Criteria
  const satisfiesScore = matchScore >= minScoreThreshold;
  const qualifies = satisfiesScore && meetsMinCriteria;

  // 4. Selective Disclosure
  usedNullifiers.insert(nullifier, true);
  // Disclosure #2: the expiry this proof was checked against. Public by
  // design — the employer's Payload Inspector shows it alongside the
  // verdict so the expiry check is itself auditable, not just asserted.
  nullifierExpiry.insert(nullifier, disclose(expiryTimestamp));

  // Disclosure #3: the single boolean verdict. matchScore itself stays private.
  const publicQualifies = disclose(qualifies);
  if (publicQualifies) {
    qualifiesCount.increment(1);
  }
}
